  @@index([description(ops: raw("gin_trgm_ops"))], type: Gin, map: "purchase_debit_notes_description_trgm")
  @@map("purchase_debit_notes")
}

model PurchaseDebitNoteLine {
  id              String            @id @default(uuid())
  noteId          String            @map("note_id")
  note            PurchaseDebitNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
