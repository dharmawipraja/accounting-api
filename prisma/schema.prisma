generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  ACCOUNTANT
  APPROVER
  VIEWER
}

model User {
  id                 String         @id @default(uuid())
  email              String
  passwordHash       String         @map("password_hash")
  name               String
  role               Role
  isActive           Boolean        @default(true) @map("is_active")
  mustChangePassword Boolean        @default(false) @map("must_change_password")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")
  deletedAt          DateTime?      @map("deleted_at")
  deletedBy          String?        @map("deleted_by")
  refreshTokens      RefreshToken[]

  @@unique([email]) // DB index name is the Prisma default "users_email_key"
  // + hand-authored UNIQUE INDEX users_email_lower_key ON users (lower(email))
  //   (20260926100000_auth_hardening) — emails are stored/looked up lowercased.
  // + hand-authored CHECK users_email_nfc (email IS NFC NORMALIZED)
  //   (20261005300000_users_email_nfc, which also backfilled NFD emails).
  @@index([deletedAt])
  @@map("users")
}

enum RefreshTokenStatus {
  ACTIVE
  CONSUMED
  REVOKED
}

model RefreshToken {
  id           String             @id
  userId       String             @map("user_id")
  familyId     String             @map("family_id")
  status       RefreshTokenStatus @default(ACTIVE)
  expiresAt    DateTime           @map("expires_at")
  createdAt    DateTime           @default(now()) @map("created_at")
  consumedAt   DateTime?          @map("consumed_at")
  replacedById String?            @map("replaced_by_id")
  /// The ONE sibling issued for a grace-window replay of this CONSUMED token;
  /// a further replay is reuse (family revoked).
  graceChildId String?            @map("grace_child_id")
  user         User               @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model CompanySettings {
  id                         String           @id @default(uuid())
  singleton                  Boolean          @unique @default(true)
  legalName                  String           @map("legal_name")
  npwp                       String?
  address                    String?
  fiscalYearStartMonth       Int              @default(1) @map("fiscal_year_start_month")
  baseCurrency               String           @default("IDR") @map("base_currency")
  segregationOfDutiesEnabled Boolean          @default(true) @map("segregation_of_duties_enabled")
  isPkp                      Boolean          @default(true) @map("is_pkp")
  /// Coretax: seller NITKU = npwp + this 6-digit place-of-business suffix.
  nitkuSuffix                String           @default("000000") @map("nitku_suffix")
  /// Coretax defaults for sales invoice lines that set none of their own.
  coretaxDefaultItemType     CoretaxItemType? @map("coretax_default_item_type")
  coretaxDefaultItemCode     String           @default("000000") @map("coretax_default_item_code")
  coretaxDefaultUnitCode     String?          @map("coretax_default_unit_code")
  createdAt                  DateTime         @default(now()) @map("created_at")
  updatedAt                  DateTime         @updatedAt @map("updated_at")

  // + hand-authored CHECKs (20261010000000_coretax): company_settings_npwp_format
  //   (npwp NULL or 16 digits), company_settings_coretax_codes_format.
  @@map("company_settings")
}

/// Coretax faktur line type: A = Barang (goods), B = Jasa (services).
enum CoretaxItemType {
  A
  B
}

/// Coretax `BuyerDocument` (Jenis ID Pembeli).
enum CoretaxBuyerDocument {
  TIN
  NATIONAL_ID
  PASSPORT
  OTHER
}

/// Lifecycle of a sales invoice's Coretax faktur pajak (metadata only).
enum TaxInvoiceStatus {
  NONE
  EXPORTED
  APPROVED
  CANCELLED
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum AccountSubtype {
  CURRENT_ASSET
  NON_CURRENT_ASSET
  FIXED_ASSET
  ACCUMULATED_DEPRECIATION
  CURRENT_LIABILITY
  NON_CURRENT_LIABILITY
  EQUITY
  REVENUE
  COGS
  OPERATING_EXPENSE
  OTHER_INCOME
  OTHER_EXPENSE
  TAX_PAYABLE
  TAX_RECEIVABLE
}

enum CashFlowCategory {
  OPERATING
  INVESTING
  FINANCING
  NONE
}

enum NormalBalance {
  DEBIT
  CREDIT
}

enum AccountRole {
  CASH
  AR_CONTROL
  AP_CONTROL
  RETAINED_EARNINGS
  OPENING_BALANCE_EQUITY
  TAX_EXPENSE
  CUSTOMER_ADVANCE
  VENDOR_ADVANCE
}

model Account {
  id                     String                  @id @default(uuid())
  code                   String
  name                   String
  type                   AccountType
  subtype                AccountSubtype
  cashFlowCategory       CashFlowCategory        @default(NONE) @map("cash_flow_category")
  role                   AccountRole?
  normalBalance          NormalBalance           @map("normal_balance")
  parentId               String?                 @map("parent_id")
  parent                 Account?                @relation("AccountHierarchy", fields: [parentId], references: [id])
  children               Account[]               @relation("AccountHierarchy")
  isPostable             Boolean                 @default(true) @map("is_postable")
  isActive               Boolean                 @default(true) @map("is_active")
  currency               String                  @default("IDR")
  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @updatedAt @map("updated_at")
  deletedAt              DateTime?               @map("deleted_at")
  deletedBy              String?                 @map("deleted_by")
  // Back-relations of the ON DELETE RESTRICT FKs (20260926300000_ledger_integrity).
  journalLines           JournalLine[]
  salesInvoiceLines      SalesInvoiceLine[]
  purchaseBillLines      PurchaseBillLine[]
  salesCreditNoteLines   SalesCreditNoteLine[]
  purchaseDebitNoteLines PurchaseDebitNoteLine[]
  cashPayments           Payment[]
  taxCodes               TaxCode[]

  @@unique([code], name: "accounts_code_unique")
  // + hand-authored UNIQUE INDEX accounts_code_lower_live_key ON accounts
  //   (lower(code)) WHERE deleted_at IS NULL (20261005000000) — codes are
  //   unique case-insensitively among live rows; the API stores them
  //   normalized (NFKC + trim, src/common/text/identifier.ts).
  @@index([deletedAt])
  @@index([parentId])
  @@map("accounts")
}

enum PeriodStatus {
  OPEN
  CLOSED
}

model AccountingPeriod {
  id         String         @id @default(uuid())
  fiscalYear Int            @map("fiscal_year")
  sequence   Int
  name       String         @unique
  startDate  DateTime       @map("start_date") @db.Date
  endDate    DateTime       @map("end_date") @db.Date
  status     PeriodStatus   @default(OPEN)
  closedAt   DateTime?      @map("closed_at")
  closedBy   String?        @map("closed_by")
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")
  entries    JournalEntry[]

  // + hand-authored CHECK accounting_periods_dates_ordered (start <= end) and
  //   EXCLUDE accounting_periods_no_overlap USING gist (btree_gist) — no two
  //   periods overlap (20260926300000_ledger_integrity).
  @@unique([fiscalYear, sequence])
  @@index([startDate, endDate])
  @@map("accounting_periods")
}

enum JournalStatus {
  DRAFT
  POSTED
  REVERSED
}

enum JournalSourceType {
  MANUAL
  OPENING
  REVERSAL
  SALES_INVOICE
  PURCHASE_BILL
  PAYMENT
  CLOSING
  SALES_CREDIT_NOTE
  PURCHASE_DEBIT_NOTE
}

enum CloseStatus {
  OPEN
  CLOSED
}

model JournalSequence {
  fiscalYear Int      @id @map("fiscal_year")
  nextNumber Int      @default(1) @map("next_number")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("journal_sequences")
}

model JournalEntry {
  id                  String               @id @default(uuid())
  entryNumber         Int?                 @map("entry_number")
  entryRef            String?              @map("entry_ref")
  fiscalYear          Int?                 @map("fiscal_year")
  date                DateTime             @db.Date
  periodId            String?              @map("period_id")
  period              AccountingPeriod?    @relation(fields: [periodId], references: [id], onDelete: Restrict)
  description         String
  sourceType          JournalSourceType    @map("source_type")
  sourceId            String?              @map("source_id")
  status              JournalStatus        @default(DRAFT)
  reversalOfId        String?              @map("reversal_of_id")
  // Self-relations (20260927000000_journal_link_fks, ON DELETE RESTRICT).
  // reversal_of_id is @@unique, so each original has at most one reversal.
  reversalOf          JournalEntry?        @relation("JournalEntryReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversal            JournalEntry?        @relation("JournalEntryReversal")
  reversedById        String?              @map("reversed_by_id")
  reversedBy          JournalEntry?        @relation("JournalEntryReversedBy", fields: [reversedById], references: [id], onDelete: Restrict)
  reversedEntries     JournalEntry[]       @relation("JournalEntryReversedBy")
  createdBy           String               @map("created_by")
  postedBy            String?              @map("posted_by")
  postedAt            DateTime?            @map("posted_at")
  // DB-only: xid of the tx that posted the entry, set + frozen by trigger
  // (20260926300000_ledger_integrity); keys the posted-line insert guard.
  postedXid           Unsupported("xid8")? @map("posted_xid")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  deletedAt           DateTime?            @map("deleted_at")
  deletedBy           String?              @map("deleted_by")
  lines               JournalLine[]
  salesInvoices       SalesInvoice[]
  purchaseBills       PurchaseBill[]
  payments            Payment[]
  paymentApplications PaymentApplication[]
  salesCreditNotes    SalesCreditNote[]
  purchaseDebitNotes  PurchaseDebitNote[]
  yearEndClosings     YearEndClosing[]

  // DB-level invariants (20260926300000_ledger_integrity), hand-authored:
  //   CHECK journal_entries_posted_complete (DRAFT ⇔ posted_at NULL; non-DRAFT
  //   carries entry_number/fiscal_year/period_id/posted_at); deferred constraint
  //   trigger journal_entries_balanced (posted ⇒ >= 2 lines, debit = credit);
  //   trigger journal_entries_immutable (posted rows: the only UPDATE allowed is
  //   POSTED->REVERSED + reversed_by_id NULL->id (+ updated_at); no DELETE /
  //   soft delete); trigger journal_entries_stamp_posted_xid;
  //   no TRUNCATE; partial index journal_entries_posted_live_date_idx
  //   ON (date) WHERE posted_at IS NOT NULL AND deleted_at IS NULL.
  @@unique([fiscalYear, entryNumber], name: "journal_entries_fy_number_unique")
  // At most one reversal per original (Postgres allows many NULLs, so non-reversal
  // rows are unaffected). Blocks concurrent/duplicate reversals at the DB layer.
  @@unique([reversalOfId])
  @@index([date])
  @@index([periodId])
  @@index([reversedById])
  @@index([status])
  @@index([deletedAt])
  @@index([entryRef(ops: raw("gin_trgm_ops"))], type: Gin, map: "journal_entries_entry_ref_trgm")
  @@index([description(ops: raw("gin_trgm_ops"))], type: Gin, map: "journal_entries_description_trgm")
  @@map("journal_entries")
}

model JournalLine {
  id             String       @id @default(uuid())
  journalEntryId String       @map("journal_entry_id")
  entry          JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)
  lineNo         Int          @map("line_no")
  // FK (RESTRICT) to Account; postable/active validity is still enforced in
  // PostingService. Accounts are only soft-deleted, so the FK never blocks.
  accountId      String       @map("account_id")
  account        Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)
  debit          Decimal      @default(0) @db.Decimal(20, 4)
  credit         Decimal      @default(0) @db.Decimal(20, 4)
  description    String?
  createdAt      DateTime     @default(now()) @map("created_at")

  // + hand-authored triggers (20260926300000_ledger_integrity): lines of a
  //   posted entry cannot be updated/deleted, and may be inserted only by the
  //   tx that created the posted entry; deferred balance check; no TRUNCATE.
  @@unique([journalEntryId, lineNo])
  @@index([accountId, journalEntryId])
  @@index([journalEntryId])
  @@map("journal_lines")
}

model IdempotencyKey {
  // Namespaced per user so one caller can never replay (or squat on) another
  // caller's key. No FK on purpose: this is a short-TTL cache table.
  userId           String    @map("user_id")
  key              String
  method           String
  path             String
  requestHash      String    @map("request_hash")
  response         Json?
  httpStatus       Int?      @map("http_status")
  createdAt        DateTime  @default(now()) @map("created_at")
  completedAt      DateTime? @map("completed_at")
  // Set inside the business tx (PrismaService.transaction) — durable iff the
  // write committed. Such a row is never released or stale-reclaimed.
  committedAt      DateTime? @map("committed_at")
  // Fencing token, fresh per reservation (a stale reclaim rotates it). Every
  // write to the row after reserve() matches on it, so a reclaimed attempt can
  // never mark/complete/release the newer owner's reservation.
  reservationToken String    @default(dbgenerated("gen_random_uuid()")) @map("reservation_token") @db.Uuid

  @@id([userId, key])
  @@map("idempotency_keys")
}

enum TaxKind {
  PPN_OUTPUT
  PPN_INPUT
  PPH_PAYABLE
  PPH_PREPAID
}

model TaxCode {
  id             String    @id @default(uuid())
  code           String
  name           String
  kind           TaxKind
  rate           Decimal   @db.Decimal(9, 6)
  /// Coretax presentation only (PPN_OUTPUT): DPP Nilai Lain = 11/12 × DPP
  /// (PMK 131/2024) and the statutory VATRate shown on the faktur.
  dppNilaiLain   Boolean   @default(false) @map("dpp_nilai_lain")
  coretaxVatRate Decimal?  @map("coretax_vat_rate") @db.Decimal(5, 2)
  taxAccountId   String    @map("tax_account_id")
  taxAccount     Account   @relation(fields: [taxAccountId], references: [id], onDelete: Restrict)
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")
  deletedBy      String?   @map("deleted_by")

  @@unique([code], name: "tax_codes_code_unique")
  // + hand-authored UNIQUE INDEX tax_codes_code_lower_live_key ON tax_codes
  //   (lower(code)) WHERE deleted_at IS NULL (20261005000000).
  @@index([deletedAt])
  @@index([taxAccountId])
  @@map("tax_codes")
}

enum DocumentStatus {
  DRAFT
  POSTED
  VOID
}

enum PaymentDirection {
  RECEIPT
  DISBURSEMENT
}

model BusinessPartner {
  id                  String               @id @default(uuid())
  code                String
  name                String
  npwp                String?
  email               String?
  phone               String?
  address             String?
  isCustomer          Boolean              @default(false) @map("is_customer")
  isVendor            Boolean              @default(false) @map("is_vendor")
  /// Coretax buyer identity (BuyerDocument / BuyerDocumentNumber /
  /// BuyerIDTKU suffix / BuyerCountry).
  buyerDocumentType   CoretaxBuyerDocument @default(TIN) @map("buyer_document_type")
  buyerDocumentNumber String?              @map("buyer_document_number")
  nitkuSuffix         String               @default("000000") @map("nitku_suffix")
  country             String               @default("IDN")
  isActive            Boolean              @default(true) @map("is_active")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  deletedAt           DateTime?            @map("deleted_at")
  deletedBy           String?              @map("deleted_by")
  salesInvoices       SalesInvoice[]
  purchaseBills       PurchaseBill[]
  payments            Payment[]
  salesCreditNotes    SalesCreditNote[]
  purchaseDebitNotes  PurchaseDebitNote[]

  // + hand-authored CHECK business_partners_customer_or_vendor (is_customer OR is_vendor)
  // + hand-authored CHECKs (20261010000000_coretax): business_partners_npwp_format
  //   (NULL or 16 digits), business_partners_coretax_format.
  @@unique([code], name: "business_partners_code_unique")
  // + hand-authored UNIQUE INDEX business_partners_code_lower_live_key ON
  //   business_partners (lower(code)) WHERE deleted_at IS NULL (20261005000000).
  @@index([deletedAt])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "business_partners_name_trgm")
  @@index([code(ops: raw("gin_trgm_ops"))], type: Gin, map: "business_partners_code_trgm")
  @@index([npwp(ops: raw("gin_trgm_ops"))], type: Gin, map: "business_partners_npwp_trgm")
  @@index([email(ops: raw("gin_trgm_ops"))], type: Gin, map: "business_partners_email_trgm")
  @@map("business_partners")
}

model SalesInvoice {
  id                    String               @id @default(uuid())
  invoiceNumber         Int?                 @map("invoice_number")
  invoiceRef            String?              @map("invoice_ref")
  fiscalYear            Int?                 @map("fiscal_year")
  partnerId             String               @map("partner_id")
  partner               BusinessPartner      @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  date                  DateTime             @db.Date
  dueDate               DateTime?            @map("due_date") @db.Date
  description           String?
  status                DocumentStatus       @default(DRAFT)
  subtotal              Decimal              @default(0) @db.Decimal(20, 4)
  taxTotal              Decimal              @default(0) @map("tax_total") @db.Decimal(20, 4)
  withholdingTotal      Decimal              @default(0) @map("withholding_total") @db.Decimal(20, 4)
  total                 Decimal              @default(0) @db.Decimal(20, 4)
  amountPaid            Decimal              @default(0) @map("amount_paid") @db.Decimal(20, 4)
  /// Sum of the lines' discountAmount (subtotal is already net of it).
  discountTotal         Decimal              @default(0) @map("discount_total") @db.Decimal(20, 4)
  /// Settled by POSTED credit/debit notes (their creditedAmount); outstanding
  /// = total − amountPaid − creditedTotal.
  creditedTotal         Decimal              @default(0) @map("credited_total") @db.Decimal(20, 4)
  journalEntryId        String?              @map("journal_entry_id")
  createdBy             String               @map("created_by")
  postedBy              String?              @map("posted_by")
  postedAt              DateTime?            @map("posted_at")
  voidedOn              DateTime?            @map("voided_on") @db.Date
  createdAt             DateTime             @default(now()) @map("created_at")
  updatedAt             DateTime             @updatedAt @map("updated_at")
  deletedAt             DateTime?            @map("deleted_at")
  deletedBy             String?              @map("deleted_by")
  /// Coretax kode transaksi override (null = derived: 04 with DPP Nilai Lain, else 01).
  trxCode               String?              @map("trx_code")
  /// Faktur pajak metadata, recorded after upload/approval in Coretax —
  /// never part of the posted content (editable on POSTED rows).
  taxInvoiceNumber      String?              @map("tax_invoice_number")
  taxInvoiceDate        DateTime?            @map("tax_invoice_date") @db.Date
  taxInvoiceStatus      TaxInvoiceStatus     @default(NONE) @map("tax_invoice_status")
  coretaxExportedAt     DateTime?            @map("coretax_exported_at")
  /// Bukti potong PPh received from the customer (PPH_PREPAID).
  withholdingSlipNumber String?              @map("withholding_slip_number")
  withholdingSlipDate   DateTime?            @map("withholding_slip_date") @db.Date
  lines                 SalesInvoiceLine[]
  notes                 SalesCreditNote[]
  journalEntry          JournalEntry?        @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)
  allocations           PaymentAllocation[]
  applications          PaymentApplication[]

  // + hand-authored CHECK sales_invoices_amount_paid_range (0 <= amount_paid <= total)
  // + hand-authored CHECK sales_invoices_credited_total_range (credited_total >= 0 AND amount_paid + credited_total <= total)
  // + hand-authored CHECK sales_invoices_discount_total_nonnegative (discount_total >= 0)
  // + hand-authored CHECK sales_invoices_journal_entry_iff_not_draft ((status = 'DRAFT') = (journal_entry_id IS NULL))
  // + hand-authored CHECK sales_invoices_coretax_format (trx_code, 17-digit NSFP,
  //   APPROVED ⇒ NSFP + date) and partial UNIQUE INDEX
  //   sales_invoices_tax_invoice_number_live_key ON (btrim(tax_invoice_number))
  //   WHERE deleted_at IS NULL AND tax_invoice_number IS NOT NULL (20261010000000) → 409.
  @@unique([fiscalYear, invoiceNumber], name: "sales_invoices_fy_number_unique")
  @@index([deletedAt])
  @@index([partnerId])
  @@index([status, date])
  @@index([journalEntryId])
  @@index([invoiceRef(ops: raw("gin_trgm_ops"))], type: Gin, map: "sales_invoices_invoice_ref_trgm")
  @@index([description(ops: raw("gin_trgm_ops"))], type: Gin, map: "sales_invoices_description_trgm")
  @@map("sales_invoices")
}

model SalesInvoiceLine {
  id              String                @id @default(uuid())
  salesInvoiceId  String                @map("sales_invoice_id")
  invoice         SalesInvoice          @relation(fields: [salesInvoiceId], references: [id], onDelete: Cascade)
  lineNo          Int                   @map("line_no")
  description     String
  accountId       String                @map("account_id")
  account         Account               @relation(fields: [accountId], references: [id], onDelete: Restrict)
  quantity        Decimal               @db.Decimal(20, 4)
  unitPrice       Decimal               @map("unit_price") @db.Decimal(20, 4)
  // Discount applied before tax: what the user entered (percent; null for a
  // fixed or no discount) and the resolved amount. `amount` is NET (the DPP).
  discountPercent Decimal?              @map("discount_percent") @db.Decimal(7, 4)
  discountAmount  Decimal               @default(0) @map("discount_amount") @db.Decimal(20, 4)
  amount          Decimal               @db.Decimal(20, 4)
  // No FK: an array of tax code ids (validated by the app).
  taxCodeIds      String[]              @map("tax_code_ids")
  /// Coretax line fields; null = the company default.
  coretaxItemType CoretaxItemType?      @map("coretax_item_type")
  coretaxItemCode String?               @map("coretax_item_code")
  coretaxUnitCode String?               @map("coretax_unit_code")
  noteLines       SalesCreditNoteLine[]

  // + hand-authored CHECK sales_invoice_lines_nonnegative (quantity, unit_price >= 0)
  // + hand-authored CHECK sales_invoice_lines_valid_discount (0 <= discount_amount <= round(quantity*unit_price, 4), amount >= 0, percent in [0, 100])
  @@unique([salesInvoiceId, lineNo])
  @@index([accountId])
  @@map("sales_invoice_lines")
}

model PurchaseBill {
  id                    String               @id @default(uuid())
  billNumber            Int?                 @map("bill_number")
  billRef               String?              @map("bill_ref")
  fiscalYear            Int?                 @map("fiscal_year")
  partnerId             String               @map("partner_id")
  partner               BusinessPartner      @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  vendorInvoiceNo       String?              @map("vendor_invoice_no")
  date                  DateTime             @db.Date
  dueDate               DateTime?            @map("due_date") @db.Date
  description           String?
  status                DocumentStatus       @default(DRAFT)
  subtotal              Decimal              @default(0) @db.Decimal(20, 4)
  taxTotal              Decimal              @default(0) @map("tax_total") @db.Decimal(20, 4)
  withholdingTotal      Decimal              @default(0) @map("withholding_total") @db.Decimal(20, 4)
  total                 Decimal              @default(0) @db.Decimal(20, 4)
  amountPaid            Decimal              @default(0) @map("amount_paid") @db.Decimal(20, 4)
  /// Sum of the lines' discountAmount (subtotal is already net of it).
  discountTotal         Decimal              @default(0) @map("discount_total") @db.Decimal(20, 4)
  /// Settled by POSTED credit/debit notes (their creditedAmount); outstanding
  /// = total − amountPaid − creditedTotal.
  creditedTotal         Decimal              @default(0) @map("credited_total") @db.Decimal(20, 4)
  journalEntryId        String?              @map("journal_entry_id")
  createdBy             String               @map("created_by")
  postedBy              String?              @map("posted_by")
  postedAt              DateTime?            @map("posted_at")
  voidedOn              DateTime?            @map("voided_on") @db.Date
  createdAt             DateTime             @default(now()) @map("created_at")
  updatedAt             DateTime             @updatedAt @map("updated_at")
  deletedAt             DateTime?            @map("deleted_at")
  deletedBy             String?              @map("deleted_by")
  /// Bukti potong (BPPU) issued in Coretax for the PPh we withheld (PPH_PAYABLE).
  withholdingSlipNumber String?              @map("withholding_slip_number")
  withholdingSlipDate   DateTime?            @map("withholding_slip_date") @db.Date
  lines                 PurchaseBillLine[]
  notes                 PurchaseDebitNote[]
  journalEntry          JournalEntry?        @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)
  allocations           PaymentAllocation[]
  applications          PaymentApplication[]

  // + hand-authored CHECK purchase_bills_amount_paid_range (0 <= amount_paid <= total)
  // + hand-authored CHECK purchase_bills_credited_total_range (credited_total >= 0 AND amount_paid + credited_total <= total)
  // + hand-authored CHECK purchase_bills_discount_total_nonnegative (discount_total >= 0)
  // + hand-authored CHECK purchase_bills_journal_entry_iff_not_draft ((status = 'DRAFT') = (journal_entry_id IS NULL))
  @@unique([fiscalYear, billNumber], name: "purchase_bills_fy_number_unique")
  // + hand-authored partial UNIQUE INDEX purchase_bills_partner_vendor_invoice_norm_live_key
  //   ON (partner_id, lower(btrim(vendor_invoice_no))) WHERE deleted_at IS NULL
  //   AND status <> 'VOID' AND vendor_invoice_no IS NOT NULL
  //   AND btrim(vendor_invoice_no) <> '' (20260930000000, replaces the exact-match
  //   index of 20260926200000) — duplicate → 409.
  @@index([deletedAt])
  @@index([partnerId])
  @@index([status, date])
  @@index([journalEntryId])
  @@index([billRef(ops: raw("gin_trgm_ops"))], type: Gin, map: "purchase_bills_bill_ref_trgm")
  @@index([vendorInvoiceNo(ops: raw("gin_trgm_ops"))], type: Gin, map: "purchase_bills_vendor_invoice_no_trgm")
  @@index([description(ops: raw("gin_trgm_ops"))], type: Gin, map: "purchase_bills_description_trgm")
  @@map("purchase_bills")
}

model PurchaseBillLine {
  id              String                  @id @default(uuid())
  purchaseBillId  String                  @map("purchase_bill_id")
  bill            PurchaseBill            @relation(fields: [purchaseBillId], references: [id], onDelete: Cascade)
  lineNo          Int                     @map("line_no")
  description     String
  accountId       String                  @map("account_id")
  account         Account                 @relation(fields: [accountId], references: [id], onDelete: Restrict)
  quantity        Decimal                 @db.Decimal(20, 4)
  unitPrice       Decimal                 @map("unit_price") @db.Decimal(20, 4)
  // Discount applied before tax: what the user entered (percent; null for a
  // fixed or no discount) and the resolved amount. `amount` is NET (the DPP).
  discountPercent Decimal?                @map("discount_percent") @db.Decimal(7, 4)
  discountAmount  Decimal                 @default(0) @map("discount_amount") @db.Decimal(20, 4)
  amount          Decimal                 @db.Decimal(20, 4)
  // No FK: an array of tax code ids (validated by the app).
  taxCodeIds      String[]                @map("tax_code_ids")
  noteLines       PurchaseDebitNoteLine[]

  // + hand-authored CHECK purchase_bill_lines_nonnegative (quantity, unit_price >= 0)
  // + hand-authored CHECK purchase_bill_lines_valid_discount (0 <= discount_amount <= round(quantity*unit_price, 4), amount >= 0, percent in [0, 100])
  @@unique([purchaseBillId, lineNo])
  @@index([accountId])
  @@map("purchase_bill_lines")
}

model Payment {
  id              String               @id @default(uuid())
  number          Int?
  ref             String?
  fiscalYear      Int?                 @map("fiscal_year")
  direction       PaymentDirection
  partnerId       String               @map("partner_id")
  partner         BusinessPartner      @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  date            DateTime             @db.Date
  cashAccountId   String               @map("cash_account_id")
  cashAccount     Account              @relation(fields: [cashAccountId], references: [id], onDelete: Restrict)
  // + hand-authored CHECK payments_amount_positive (amount > 0)
  // + hand-authored CHECK payments_journal_entry_iff_not_draft ((status = 'DRAFT') = (journal_entry_id IS NULL))
  amount          Decimal              @db.Decimal(20, 4)
  // amount − allocations − live applications: the part still sitting on the
  // CUSTOMER_ADVANCE / VENDOR_ADVANCE account. 0 once VOID.
  // + hand-authored CHECK payments_unapplied_amount_range (0 <= unapplied_amount <= amount)
  unappliedAmount Decimal              @default(0) @map("unapplied_amount") @db.Decimal(20, 4)
  description     String?
  status          DocumentStatus       @default(DRAFT)
  journalEntryId  String?              @map("journal_entry_id")
  createdBy       String               @map("created_by")
  postedBy        String?              @map("posted_by")
  postedAt        DateTime?            @map("posted_at")
  voidedOn        DateTime?            @map("voided_on") @db.Date
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")
  deletedAt       DateTime?            @map("deleted_at")
  deletedBy       String?              @map("deleted_by")
  allocations     PaymentAllocation[]
  applications    PaymentApplication[]
  journalEntry    JournalEntry?        @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)

  // RECEIPT and DISBURSEMENT have independent gapless sequences (PAY-RCV / PAY-DSB),
  // so the number is unique per (direction, fiscalYear), not per fiscalYear alone.
  @@unique([direction, fiscalYear, number], name: "payments_direction_fy_number_unique")
  @@index([deletedAt])
  @@index([partnerId])
  @@index([journalEntryId])
  @@index([cashAccountId])
  @@index([ref(ops: raw("gin_trgm_ops"))], type: Gin, map: "payments_ref_trgm")
  @@index([description(ops: raw("gin_trgm_ops"))], type: Gin, map: "payments_description_trgm")
  @@map("payments")
}

model PaymentAllocation {
  id             String        @id @default(uuid())
  paymentId      String        @map("payment_id")
  payment        Payment       @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  salesInvoiceId String?       @map("sales_invoice_id")
  salesInvoice   SalesInvoice? @relation(fields: [salesInvoiceId], references: [id], onDelete: Restrict)
  purchaseBillId String?       @map("purchase_bill_id")
  purchaseBill   PurchaseBill? @relation(fields: [purchaseBillId], references: [id], onDelete: Restrict)
  amount         Decimal       @db.Decimal(20, 4)

  // + hand-authored CHECKs: payment_allocations_amount_positive (amount > 0),
  //   payment_allocations_one_target (exactly one of the two targets).

  @@index([paymentId])
  @@index([salesInvoiceId])
  @@index([purchaseBillId])
  @@map("payment_allocations")
}

/// A later move of part of a POSTED payment's unapplied (advance) amount onto
/// an invoice/bill: its own journal (Dr Uang Muka Pelanggan / Cr AR, or
/// Dr AP / Cr Uang Muka Pembelian). Live on [date, reversedOn).
model PaymentApplication {
  id                  String             @id @default(uuid())
  // The credit applied: a payment's unapplied advance, or (20261009000000) a
  // credit/debit note's unapplied excess — exactly one of the three is set.
  paymentId           String?            @map("payment_id")
  payment             Payment?           @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  salesCreditNoteId   String?            @map("sales_credit_note_id")
  salesCreditNote     SalesCreditNote?   @relation(fields: [salesCreditNoteId], references: [id], onDelete: Restrict)
  purchaseDebitNoteId String?            @map("purchase_debit_note_id")
  purchaseDebitNote   PurchaseDebitNote? @relation(fields: [purchaseDebitNoteId], references: [id], onDelete: Restrict)
  salesInvoiceId      String?            @map("sales_invoice_id")
  salesInvoice        SalesInvoice?      @relation(fields: [salesInvoiceId], references: [id], onDelete: Restrict)
  purchaseBillId      String?            @map("purchase_bill_id")
  purchaseBill        PurchaseBill?      @relation(fields: [purchaseBillId], references: [id], onDelete: Restrict)
  amount              Decimal            @db.Decimal(20, 4)
  date                DateTime           @db.Date
  journalEntryId      String             @unique @map("journal_entry_id")
  journalEntry        JournalEntry       @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)
  createdBy           String             @map("created_by")
  createdAt           DateTime           @default(now()) @map("created_at")
  reversedOn          DateTime?          @map("reversed_on") @db.Date
  reversedBy          String?            @map("reversed_by")

  // + hand-authored CHECKs: payment_applications_amount_positive (amount > 0),
  //   payment_applications_one_target (exactly one of the two targets),
  //   payment_applications_reversal_shape (reversed_on/by set together, reversed_on >= date),
  //   payment_applications_one_source (exactly one of payment / credit note / debit note).

  @@index([paymentId])
  @@index([salesCreditNoteId])
  @@index([purchaseDebitNoteId])
  @@index([salesInvoiceId])
  @@index([purchaseBillId])
  @@map("payment_applications")
}

/// Nota retur penjualan (sales credit note): returns part of ONE posted SalesInvoice (same partner). Lines copy the
/// original line's price/discount/account/tax codes; the posted journal mirrors
/// the original's for the returned part. creditedAmount settles the original
/// (its creditedTotal); the rest (unappliedAmount at post) is partner credit on
/// the advance account, applied later like a payment advance.
model SalesCreditNote {
  id               String                @id @default(uuid())
  number           Int?
  ref              String?
  fiscalYear       Int?                  @map("fiscal_year")
  partnerId        String                @map("partner_id")
  partner          BusinessPartner       @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  originalId       String                @map("original_id")
  original         SalesInvoice          @relation(fields: [originalId], references: [id], onDelete: Restrict)
  date             DateTime              @db.Date
  description      String?
  status           DocumentStatus        @default(DRAFT)
  subtotal         Decimal               @default(0) @db.Decimal(20, 4)
  taxTotal         Decimal               @default(0) @map("tax_total") @db.Decimal(20, 4)
  withholdingTotal Decimal               @default(0) @map("withholding_total") @db.Decimal(20, 4)
  total            Decimal               @default(0) @db.Decimal(20, 4)
  discountTotal    Decimal               @default(0) @map("discount_total") @db.Decimal(20, 4)
  /// Part of total that settled the original (fixed at post; 0 for a draft).
  creditedAmount   Decimal               @default(0) @map("credited_amount") @db.Decimal(20, 4)
  /// Remaining partner credit (excess not yet applied); 0 once VOID.
  unappliedAmount  Decimal               @default(0) @map("unapplied_amount") @db.Decimal(20, 4)
  journalEntryId   String?               @map("journal_entry_id")
  createdBy        String                @map("created_by")
  postedBy         String?               @map("posted_by")
  postedAt         DateTime?             @map("posted_at")
  voidedOn         DateTime?             @map("voided_on") @db.Date
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")
  deletedAt        DateTime?             @map("deleted_at")
  deletedBy        String?               @map("deleted_by")
  /// Coretax retur (nota retur / pembatalan) reference — metadata only.
  returNumber      String?               @map("retur_number")
  returDate        DateTime?             @map("retur_date") @db.Date
  lines            SalesCreditNoteLine[]
  journalEntry     JournalEntry?         @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)
  applications     PaymentApplication[]

  // + hand-authored CHECKs (20261009000000): sales_credit_notes_amounts_valid (money >= 0,
  //   credited_amount + unapplied_amount <= total), sales_credit_notes_journal_entry_iff_not_draft.
  @@unique([fiscalYear, number], name: "sales_credit_notes_fy_number_unique")
  @@index([deletedAt])
  @@index([partnerId])
  @@index([originalId])
  @@index([journalEntryId])
  @@index([ref(ops: raw("gin_trgm_ops"))], type: Gin, map: "sales_credit_notes_ref_trgm")
  @@index([description(ops: raw("gin_trgm_ops"))], type: Gin, map: "sales_credit_notes_description_trgm")
  @@map("sales_credit_notes")
}

model SalesCreditNoteLine {
  id              String           @id @default(uuid())
  noteId          String           @map("note_id")
  note            SalesCreditNote  @relation(fields: [noteId], references: [id], onDelete: Cascade)
  lineNo          Int              @map("line_no")
  /// The returned line of the original document.
  originalLineId  String           @map("original_line_id")
  originalLine    SalesInvoiceLine @relation(fields: [originalLineId], references: [id], onDelete: Restrict)
  description     String
  accountId       String           @map("account_id")
  account         Account          @relation(fields: [accountId], references: [id], onDelete: Restrict)
  quantity        Decimal          @db.Decimal(20, 4)
  unitPrice       Decimal          @map("unit_price") @db.Decimal(20, 4)
  discountPercent Decimal?         @map("discount_percent") @db.Decimal(7, 4)
  discountAmount  Decimal          @default(0) @map("discount_amount") @db.Decimal(20, 4)
  amount          Decimal          @db.Decimal(20, 4)
  taxCodeIds      String[]         @map("tax_code_ids")

  // + hand-authored CHECK sales_credit_note_lines_valid (quantity > 0, unit_price >= 0, valid discount)
  @@unique([noteId, lineNo])
  @@index([accountId])
  @@index([originalLineId])
  @@map("sales_credit_note_lines")
}

/// Nota retur pembelian (purchase debit note): returns part of ONE posted PurchaseBill (same partner). Lines copy the
