  subtotal         Decimal                 @default(0) @db.Decimal(20, 4)
  taxTotal         Decimal                 @default(0) @map("tax_total") @db.Decimal(20, 4)
  withholdingTotal Decimal                 @default(0) @map("withholding_total") @db.Decimal(20, 4)
  total            Decimal                 @default(0) @db.Decimal(20, 4)
  discountTotal    Decimal                 @default(0) @map("discount_total") @db.Decimal(20, 4)
  /// Part of total that settled the original (fixed at post; 0 for a draft).
  creditedAmount   Decimal                 @default(0) @map("credited_amount") @db.Decimal(20, 4)
  /// Remaining partner credit (excess not yet applied); 0 once VOID.
  unappliedAmount  Decimal                 @default(0) @map("unapplied_amount") @db.Decimal(20, 4)
