# Environment configuration.
#
# How environments are selected:
#   npm scripts set NODE_ENV (cross-env); ConfigModule loads [.env.<NODE_ENV>, .env]
#   (the env-specific file wins; real process.env wins over both).
#
# Which file to create:
#   .env             -> shared base + docker compose interpolation (POSTGRES_PASSWORD).
#                       Copy this template here and fill in real secret values.
#   .env.development -> local dev overrides (loaded by `npm run start:dev`).
#                       At minimum a DATABASE_URL pointing at a dev database, e.g.:
#                       DATABASE_URL=postgresql://accounting:accounting@localhost:5432/accounting_dev?schema=public
#   test             -> configured in code (test/setup-env.ts) + ephemeral
#                       testcontainers. No .env.test needed.
#   production        -> injected by docker compose. No .env.production needed.

NODE_ENV=development
PORT=3000
# DB passwords end up inside connection URLs: use URL-safe characters only
# (A-Z a-z 0-9 . _ ~ -) or percent-encode reserved ones (@ → %40) in any URL
# you write by hand, e.g. DATABASE_URL below.
POSTGRES_PASSWORD=accounting
# DATABASE_URL = the URL the API connects with. Local dev uses the OWNER
# (`accounting`, needed by `prisma migrate dev`). In production
# (docker-compose.prod.yml) the api instead connects as the least-privilege
# `accounting_app` role (DML only, no DDL/TRUNCATE) and only the migrate
# service uses the owner URL — see docs/runbooks/deploy.md "Database roles".
DATABASE_URL=postgresql://accounting:accounting@localhost:5432/accounting?schema=public
# Password for the `accounting_app` role. REQUIRED by docker-compose.prod.yml
# (db init hook, migrate grants step, api DATABASE_URL); unused in local dev.
# MUST be URL-safe — only A-Z a-z 0-9 . _ ~ - (e.g. `openssl rand -hex 24`):
# compose embeds it unencoded in the api DATABASE_URL, and the migrate grants
# step (scripts/db/ensure-app-role.js) rejects anything else.
# APP_DB_PASSWORD=
# CD / pre-built images (docker-compose.prod.yml): defaults build locally.
# API_IMAGE=accounting-api:local                  # e.g. ghcr.io/<owner>/<repo>:<sha>
# MIGRATE_IMAGE=accounting-api-migrate:local      # e.g. ghcr.io/<owner>/<repo>-migrate:<sha>
JWT_ACCESS_SECRET=replace-with-a-32+-character-random-secret-value
JWT_REFRESH_SECRET=replace-with-a-different-32+-character-secret
# Secrets MUST differ. TTLs are validated: access ≤ 3600s, refresh ≤ 30d.
JWT_ACCESS_TTL=900s
JWT_REFRESH_TTL=7d
# Comma-separated browser origins allowed by CORS; unset/empty = CORS disabled.
# The localhost value below is for local dev ONLY: with NODE_ENV=production
# (docker compose) startup REJECTS *, non-https and localhost/loopback entries —
# set the real frontend origin(s) (https://app.example.com) or leave it empty.
CORS_ORIGIN=http://localhost:5173

# Redis (rate-limit storage). Required in dev & prod; tests/CI run in-memory.
REDIS_URL=redis://localhost:6379

# --- Optional ---
# docker compose passes each optional var below to the api container as
# ${VAR:-<app default>} (docker-compose.yml; DB_POOL_MAX/DB_STATEMENT_TIMEOUT_MS in
# docker-compose.prod.yml). Numeric/enum vars default to the app's value (an empty
# value would fail startup validation); CORS_ORIGIN, METRICS_TOKEN and SENTRY_*
# default to empty, which the app treats as unset.
# REPORT_UTC_OFFSET_MINUTES=420     # minutes east of UTC for a defaulted report "today" (420 = WIB).
# --- Monitoring overlay (docker-compose.monitoring.yml) ---
# GRAFANA_ADMIN_PASSWORD=            # required when running the monitoring overlay
# ALERT_SLACK_WEBHOOK_URL=           # set to deliver alerts to Slack (native formatting)
# ALERT_SLACK_CHANNEL=#alerts        # optional Slack channel override
# ALERT_WEBHOOK_URL=                 # OR a generic webhook (custom handler / Discord + '/slack' suffix)
# ALERT_HEARTBEAT_URL=               # optional dead-man's switch (e.g. healthchecks.io ping URL)
# REQUEST_TIMEOUT_MS=35000          # per-request handler cap (ms); returns 408 if exceeded.
#                                   # Keep DB_STATEMENT_TIMEOUT_MS (30s) < this < the 40s server
#                                   # requestTimeout, so the DB aborts work first and the socket
#                                   # isn't cut before the 408 envelope can be returned.
# METRICS_TOKEN=                     # bearer token gating /metrics (required+fail-closed in prod if set)
# SENTRY_DSN=                        # enables error reporting when set
# SENTRY_ENVIRONMENT=                # overrides NODE_ENV in Sentry events
# SENTRY_RELEASE=                    # release tag for Sentry
# THROTTLE_LIMIT=300                 # global requests / 60s per authenticated user
# THROTTLE_LOGIN_LIMIT=10            # login attempts / 60s per email (account)
# THROTTLE_LOGIN_IP_LIMIT=30         # login attempts / 60s per client IP (any emails)
# ARGON2_MAX_CONCURRENCY=8           # concurrent argon2 hash/verify per process (1-64); excess waits ≤5s then 503
# TRUST_PROXY_HOPS=                  # Express 'trust proxy' hops (0-10). Default: 1 in production
#                                    # (Caddy -> api), 0 elsewhere (X-Forwarded-For ignored).
#                                    # Compose: docker-compose.prod.yml passes 1, the base file alone 0
# THROTTLE_REFRESH_LIMIT=30          # refresh+logout / 60s per IP
# THROTTLE_CHANGE_PASSWORD_LIMIT=10  # change-password attempts / 60s per user
# LOG_LEVEL=info                     # pino level: fatal|error|warn|info|debug|trace|silent
# ENABLE_SWAGGER=false               # 'true' to expose /docs in production
# GRAFANA_ADMIN_PASSWORD=            # for the optional docker-compose.monitoring.yml overlay
# DB_POOL_MAX=15                     # max pg pool connections (1-100)
# DB_STATEMENT_TIMEOUT_MS=30000      # per-statement timeout (ms)
# --- Backup sidecar (docker-compose.prod.yml `backup`; not read by the api) ---
# Bare integers only (no unit, no quotes); anything else makes scripts/backup.sh
# exit 64 before pg_dump. After a change: $COMPOSE up -d --no-build --no-deps backup
# RETENTION_DAYS=7                   # prune dumps older than N days (>= 1)
# BACKUP_INTERVAL=86400              # seconds between dumps (>= 60; 86400 = daily)
# IDEMPOTENCY_INFLIGHT_TTL_MS=       # stale in-flight idempotency-key reclaim window (ms)
# IDEMPOTENCY_COMPLETED_TTL_MS=      # completed idempotency-key retention before purge (ms)
